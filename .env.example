TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
GMAIL_LABEL=newsletters

# ── LLM (escolha seu provedor) ──
# Default: OpenAI gpt-4o-mini — bom custo-benefício para triagem/resumo.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_api_key
# Alternativas (veja o README):
#   Anthropic:  LLM_MODEL=claude-haiku-4-5-20251001   + LLM_API_KEY=sk-ant-...
#   Local:      LLM_MODEL=ollama/qwen2.5:7b           + LLM_API_BASE=http://localhost:11434
# LLM_API_BASE=

# Perfil do usuário (opcional). Local: use profile.yaml.
# No Actions: cole o YAML do perfil inteiro neste secret.
# USER_PROFILE=
